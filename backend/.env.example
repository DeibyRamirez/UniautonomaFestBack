# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Opción A (recomendada en local): copia el JSON de Firebase a backend/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#
# Opción B: pega client_email y private_key del mismo JSON en FIREBASE_* (no uses las dos a la vez)

# Config pública (admin / checkout en el navegador)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Resend — reemplaza re_xxxxxxxxx por tu API key real (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx
# Remitente (campo "from" de Resend). NO uses tu Gmail personal aquí.
# Pruebas: Uniautónoma Fest <onboarding@resend.dev> (solo envía a correos permitidos en sandbox)
# Producción: verifica el dominio en Resend y usa p. ej. Uniautónoma Fest <fest@uniautonoma.edu.co>
CORREO_REMITENTE=Uniautónoma Fest <onboarding@resend.dev>
# Mismo correo con el que te registraste en Resend (sandbox solo envía ahí)
RESEND_CORREO_SANDBOX=tu-cuenta@gmail.com

# Admin semilla (npm run semilla-admin) — no subas contraseñas reales al repo
ADMIN_SEMILLA_CORREO=admin@uniautonoma.edu.co
ADMIN_SEMILLA_CONTRASENA=CambiarPorContraseñaSegura123

# App
URL_BASE=http://localhost:3000
MONTO_KIT_UNIAUTONOMO=7500000
MONTO_KIT_GENERAL=8000000
PUERTO=3000
