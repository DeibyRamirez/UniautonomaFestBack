# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local: copia el JSON de Firebase a backend/service-account.json y descomenta:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#
# Vercel/producción: usa solo FIREBASE_* (no definas GOOGLE_APPLICATION_CREDENTIALS allí)

# Config pública (admin / checkout en el navegador)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Canal de correo: EMAIL_DRIVER tiene prioridad sobre USO_RESEND
# EMAIL_DRIVER=resend | smtp
EMAIL_DRIVER=smtp
# USO_RESEND=false activa SMTP cuando EMAIL_DRIVER no está definido
USO_RESEND=true
ENABLE_EMAIL_FALLBACK=false

# SMTP (universidad o Mailtrap) — activar con USO_RESEND=false o EMAIL_DRIVER=smtp
# Mailtrap Testing: host=sandbox.smtp.mailtrap.io, port=2525 o 587, SMTP_SECURE=false
# Los correos NO llegan a Gmail/Outlook: revísalos en https://mailtrap.io
# Office365/producción: port=587 + SMTP_SECURE=false | Puerto 465 + SMTP_SECURE=true
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@uniautonoma.edu.co
EMAIL_FROM_NAME=Uniautónoma Fest

# Resend — reemplaza re_xxxxxxxxx por tu API key real (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx

CORREO_REMITENTE=Uniautónoma Fest <onboarding@resend.dev>
# Mismo correo con el que te registraste en Resend (sandbox solo envía ahí)
RESEND_CORREO_SANDBOX=tu-cuenta@gmail.com

# Admin semilla (npm run semilla-admin) — no subas contraseñas reales al repo
ADMIN_SEMILLA_CORREO=admin@uniautonoma.edu.co
ADMIN_SEMILLA_CONTRASENA=CambiarPorContraseñaSegura123

# App
URL_BASE=http://localhost:3000
MONTO_KIT_UNIAUTONOMO=7500000
MONTO_KIT_GENERAL=8000000
MONTO_COMPONENTE_CARRERA=6000000
MONTO_COMPONENTE_FIESTA=2000000
MONTO_COMPONENTE_BINGO=1000000
# Legacy: el bloqueo por correo institucional APPROVED ya está siempre activo en código.
VALIDAR_PAGO_UNICO_INSTITUCIONAL=false
# Horas para reutilizar un pago PENDING institucional al reintentar (vacío = sin límite)
PENDING_REUTILIZAR_HORAS=
PUERTO=3000
