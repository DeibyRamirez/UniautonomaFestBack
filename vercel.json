{
  "version": 2,
  "installCommand": "npm ci && cd backend && npm ci",
  "buildCommand": "cd backend && npm run verify",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/checkout/(.*)", "dest": "/checkout/$1" },
    { "src": "/eventos", "dest": "/eventos/index.html" },
    { "src": "/eventos/(.*)", "dest": "/eventos/$1" },
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}
